# ---------------------------------------------------------------------------
# AYMOXI — environment variables
# Copy to `.env` for local development and add the same keys to
# Vercel → Project → Settings → Environment Variables (Production + Preview).
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Backend (safe to expose — publishable keys, used by the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
VITE_SUPABASE_PROJECT_ID=your_project_id_here

# Same values, read by server-side rendering / server routes
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# ---------------------------------------------------------------------------
# Chatbot (SERVER-SIDE ONLY — no VITE_ prefix, never reaches the browser).
# The key is read only inside src/routes/api/chat.ts.
# ---------------------------------------------------------------------------
CHATBOT_API_KEY=your_api_key_here

# Optional overrides
# CHATBOT_MODEL=google/gemini-3-flash-preview
# CHATBOT_API_URL=https://ai.gateway.lovable.dev/v1/chat/completions
